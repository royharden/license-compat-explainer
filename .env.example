# Public browser configuration (copy to .env.local). Leave empty to run in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# mock | live  (live transport source exists; infrastructure/provider activation unverified)
VITE_EXPLAIN_MODE=mock

# Server-only names for the `explain` edge function (from M4). Set them in Bolt server settings,
# never here and never with a VITE_ prefix:
#   ANTHROPIC_API_KEY, OPENAI_COMPATIBLE_API_KEY            (secrets)
#   EXPLAIN_PROVIDER, EXPLAIN_MODEL, OPENAI_COMPATIBLE_BASE_URL, EXPLAIN_MAX_OUTPUT_TOKENS,
#   EXPLAIN_TOKEN_SAFETY_FACTOR, EXPLAIN_DAILY_CAP_USD, EXPLAIN_RUN_CAP_USD, EXPLAIN_PRICE_TABLE,
#   ALLOWED_ORIGINS                                           (server settings)
# Local shell only, never deployed: EVAL_CAP_USD
# scripts/eval.ts --explain live reports not_run until a separately authorized local
# transport binds the direct Provider adapter to scripts/eval/localCampaign.ts.
